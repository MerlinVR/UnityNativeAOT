<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stage-2 spike: the same coreclr.dll impersonation as CoreClrStandIn, but with Unity's own
    managed layer (Unity.Private.Scripting, the UnityEngine modules and the game's Assembly-CSharp)
    compiled in by NativeAOT, so the engine receives the real InitializationBootstrapper.

    UnityManaged: the Managed folder of a CoreCLR player build.
    PatchedDir:   holds a copy of Unity.Private.Scripting.dll with the bootstrapper made public.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AotScripting</AssemblyName>
    <RootNamespace>CoreClrStandIn</RootNamespace>
    <OutputType>Library</OutputType>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);REAL_SCRIPTING</DefineConstants>

    <UnityManaged Condition="'$(UnityManaged)' == ''">$(MSBuildThisFileDirectory)..\builds\coreclr-standin\Managed</UnityManaged>
    <PatchedDir Condition="'$(PatchedDir)' == ''">$(MSBuildThisFileDirectory)patched</PatchedDir>

    <!-- Report every trim/AOT analysis warning individually so they can be counted. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <NoWarn>$(NoWarn);NU1903;CS0436;CS1701;CS1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\CoreClrStandIn\Exports.cs" Link="Exports.cs" />
    <Compile Include="..\CoreClrStandIn\Generated.cs" Link="Generated.cs" />
  </ItemGroup>

  <ItemGroup>
    <UnityAsm Include="$(UnityManaged)\Unity*.dll;$(UnityManaged)\Assembly-CSharp*.dll"
              Exclude="$(UnityManaged)\Unity.Private.Scripting.dll" />
    <UnityAsm Include="$(PatchedDir)\Unity.Private.Scripting.dll" />

    <!-- Copy-local so the publish pipeline hands them to ILC as compilation inputs. -->
    <Reference Include="@(UnityAsm)" />
    <!-- Root whole assemblies: the engine finds types, methods and fields by name at runtime. -->
    <TrimmerRootAssembly Include="@(UnityAsm->'%(Filename)')" />
  </ItemGroup>

</Project>
