<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Publishes the NativeAOT library that replaces CoreCLR\native\coreclr.dll in a CoreCLR player.
    It has no code of its own: ILC compiles AotRuntime (the exports and replacements), Unity's managed assemblies
    (the detoured copies where `asmdump detour` made one) and the game's assemblies into one native DLL.
    Use ..\build-aot.ps1, which prepares the inputs in the right order.

    UnityManaged  the Managed folder of a CoreCLR player build
    PatchedDir    output of `asmdump detour`
    AotRoots      assemblies compiled in full, because the engine finds their types and members by name
  -->
  <!-- build-aot.ps1 writes AotRoots here; a list cannot be passed with -p because MSBuild splits it on ';' and ','. -->
  <PropertyGroup>
    <AotRootsProps Condition="'$(AotRootsProps)' == ''">$(MSBuildThisFileDirectory)..\builds\aot-roots.props</AotRootsProps>
  </PropertyGroup>
  <Import Project="$(AotRootsProps)" Condition="Exists('$(AotRootsProps)')" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AotScripting</AssemblyName>
    <OutputType>Library</OutputType>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <UnityManaged Condition="'$(UnityManaged)' == ''">$(MSBuildThisFileDirectory)..\builds\coreclr\Managed</UnityManaged>
    <PatchedDir Condition="'$(PatchedDir)' == ''">$(MSBuildThisFileDirectory)..\builds\patched</PatchedDir>
    <AotRuntimeDll Condition="'$(AotRuntimeDll)' == ''">$(MSBuildThisFileDirectory)..\AotRuntime\bin\Release\net10.0\AotRuntime.dll</AotRuntimeDll>
    <AotRoots Condition="'$(AotRoots)' == ''">Unity.Private.Scripting;Unity.Scripting;UnityEngine.ScriptingModule;UnityEngine.CoreModule;UnityEngine.ManagedKernelModule;UnityEngine.AnimationModule;UnityEngine;Assembly-CSharp</AotRoots>

    <!-- Iteration speed over code quality by default: no optimisation and no native debug info. -->
    <Optimize Condition="'$(AotOptimize)' != 'true'">false</Optimize>
    <DebugType Condition="'$(AotSymbols)' != 'true'">none</DebugType>

    <!-- Unity's embedding layer finds members by name at run time: keep reflection data for everything compiled. -->
    <IlcTrimMetadata>false</IlcTrimMetadata>

    <!-- NativeAOT defaults to a LINQ built for size; game code runs LINQ per frame, so take the one built for speed. -->
    <UseSizeOptimizedLinq>false</UseSizeOptimizedLinq>

    <!-- The trim/AOT warnings were counted once (see README); they are noise while iterating. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>true</TrimmerSingleWarn>
    <NoWarn>$(NoWarn);NU1903;CS1701;CS1702;IL2104;IL3053;IL3000;IL3002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PatchedAsm Include="$(PatchedDir)\*.dll" />
    <UnityAsm Include="$(UnityManaged)\Unity*.dll;$(UnityManaged)\Assembly-CSharp*.dll"
              Exclude="@(PatchedAsm->'$(UnityManaged)\%(Filename)%(Extension)')" />

    <!-- Copy-local references are what the publish pipeline hands to ILC as inputs. -->
    <Reference Include="@(UnityAsm);@(PatchedAsm);$(AotRuntimeDll)" />

    <TrimmerRootAssembly Include="AotRuntime;$(AotRoots)" />
    <!-- The engine looks up corlib types and methods by name (IEnumerator.MoveNext, IDisposable.Dispose, ...). -->
    <TrimmerRootDescriptor Include="CorlibRoots.xml" />
    <!-- Export AotRuntime's [UnmanagedCallersOnly(EntryPoint = ...)] methods from the native library. -->
    <UnmanagedEntryPointsAssembly Include="AotRuntime" />
  </ItemGroup>

</Project>
